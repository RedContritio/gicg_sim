#!/usr/bin/env bash
# Gate each commit on four independent checks against STAGED files
# only (the hook does not rewrite your working tree):
#
#   1. Line + byte limits (see tools/_meta/check_line_limits.py for rules)
#   2. Python formatting: ``ruff format --check`` on staged .py files
#   3. Go formatting:     ``gofmt -l`` on staged .go files
#   4. OpenSpec index integrity (tools/_meta/check_openspec_indices.py)
#
# Enable the hook with:
#
#     git config core.hooksPath .githooks
#
# Bypass a specific failure with ``SKIP_*_HOOK=1``:
#
#     SKIP_LINE_LIMIT_HOOK=1       skip check_line_limits
#     SKIP_RUFF_HOOK=1             skip ruff format --check
#     SKIP_GOFMT_HOOK=1            skip gofmt check
#     SKIP_OPENSPEC_INDEX_HOOK=1   skip check_openspec_indices
#
# CI should run the full-tree variants:
#
#     python -m tools._meta.check_line_limits
#     ruff format --check .
#     gofmt -l ./gicg_engine ./gicg_mcts
#     python -m tools._meta.check_openspec_indices
set -euo pipefail

if [ -x '.venv/bin/python' ]; then
  PY='.venv/bin/python'
else
  PY="$(command -v python3 || command -v python)"
fi

rc=0

# 1. Line + byte limits
if [ -z "${SKIP_LINE_LIMIT_HOOK:-}" ]; then
  "$PY" -m tools._meta.check_line_limits --staged || rc=1
fi

# 2. ruff format --check on staged .py files
if [ -z "${SKIP_RUFF_HOOK:-}" ]; then
  staged_py=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
  if [ -n "$staged_py" ]; then
    if ! "$PY" -m ruff format --check $staged_py; then
      echo '  hint: run `.venv/bin/ruff format .` to fix' >&2
      rc=1
    fi
  fi
fi

# 3. gofmt -l on staged .go files
if [ -z "${SKIP_GOFMT_HOOK:-}" ]; then
  staged_go=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.go$' || true)
  if [ -n "$staged_go" ]; then
    unformatted=$(gofmt -l $staged_go || true)
    if [ -n "$unformatted" ]; then
      echo 'gofmt: files need formatting:' >&2
      echo "$unformatted" | sed 's/^/  /' >&2
      echo '  hint: run `gofmt -w ./gicg_engine ./gicg_mcts` to fix' >&2
      rc=1
    fi
  fi
fi

# 4. OpenSpec index integrity on staged openspec/ files
if [ -z "${SKIP_OPENSPEC_INDEX_HOOK:-}" ]; then
  if ! "$PY" -m tools._meta.check_openspec_indices --staged; then
    echo '  hint: fix index links or bypass with SKIP_OPENSPEC_INDEX_HOOK=1' >&2
    rc=1
  fi
fi

exit "$rc"
