      "components": [
        {
          "component_id": "card_skill",
          "layout": "",
          "data": "{\"moduleName\":\"卡牌技能\",\"layout_\":\"right\",\"list\":[{\"tab_name\":\"迅破枪势\",\"skill_type\":\"普通攻击\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/17/258999284/8a56609e13a43b82f7bac7b65fca8b87_6108669631633407412.png\",\"life\":1,\"life_bg\":4,\"energy\":2,\"energy_bg\":10,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成2点<strong><u>物理伤害</u></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><span>物理伤害不会附着元素，也不会发生元素反应。</span></p><p></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1694067287681_0\"},{\"tab_name\":\"烈烧佑命之侍护\",\"skill_type\":\"元素战技\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/17/258999284/5943ef23f4dde5b6015a06e67e8332a5_7948056671343155927.png\",\"life\":3,\"life_bg\":4,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p><span style=\\\"color: rgb(0, 0, 0)\\\">造成2点</span><strong><span style=\\\"color: rgb(207, 19, 34)\\\"><u>火元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>火元素伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>附着火元素，可发生元素反应：</p><p style=&quot;white-space: pre-wrap;&quot;>融化：本伤害+2</p><p style=&quot;white-space: pre-wrap;&quot;>蒸发：本伤害+2</p><p style=&quot;white-space: pre-wrap;&quot;>超载：本伤害+2，目标强制切换到下一个角色</p><p style=&quot;white-space: pre-wrap;&quot;>燃烧：本伤害+1，生成回合结束时造成1点火伤害的[<strong><em>燃烧烈焰</em></strong>]（可生效1次，最多叠加到2次）</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，生成</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>烈烧佑命护盾</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>烈烧佑命护盾：</span></strong></p><p><span style=&quot;color: rgb(0, 0, 0)&quot;>出战状态</span></p><p><span style=&quot;color: rgb(0, 0, 0)&quot;>为我方出战角色提供1点</span><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>护盾</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>。（可叠加，最多叠加到3点）</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">。</span></p>\"]},\"tab_id\":\"1705396058801_1\"},{\"tab_name\":\"真红炽火之大铠\",\"skill_type\":\"元素爆发\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/17/258999284/7d6cb477d20cd8b75925ce62d3b73e8e_5295401799072493605.png\",\"life\":3,\"life_bg\":4,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p><span style=\\\"color: rgb(0, 0, 0)\\\">造成2点</span><strong><span style=\\\"color: rgb(207, 19, 34)\\\"><u>火元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>火元素伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>附着火元素，可发生元素反应：</p><p style=&quot;white-space: pre-wrap;&quot;>融化：本伤害+2</p><p style=&quot;white-space: pre-wrap;&quot;>蒸发：本伤害+2</p><p style=&quot;white-space: pre-wrap;&quot;>超载：本伤害+2，目标强制切换到下一个角色</p><p style=&quot;white-space: pre-wrap;&quot;>燃烧：本伤害+1，生成回合结束时造成1点火伤害的[<strong><em>燃烧烈焰</em></strong>]（可生效1次，最多叠加到2次）</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，生成</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>烈烧佑命护盾</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>烈烧佑命护盾：</span></strong></p><p><span style=&quot;color: rgb(0, 0, 0)&quot;>出战状态</span></p><p><span style=&quot;color: rgb(0, 0, 0)&quot;>为我方出战角色提供1点</span><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>护盾</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>。（可叠加，最多叠加到3点）</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>和<strong><u>炽火大铠</u></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>炽火大铠：</span></strong></p><p><span style=&quot;color: rgb(0, 0, 0)&quot;>出战状态</span></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>我方角色普通攻击后：</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>造成1点</span><strong><span style=&quot;color: rgb(245, 34, 45)&quot;>火元素伤害</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>，生成</span><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>烈烧佑命护盾</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>。</span></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>可用次数</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>：2</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">。</span></p>\"]},\"tab_id\":\"1705396060522_2\"}]}",
          "style": ""
        }
