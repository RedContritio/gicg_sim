      "is_poped": false,
      "components": [
        {
          "component_id": "card_skill",
          "layout": "",
          "data": "{\"list\":[{\"tab_name\":\"Plama Lawa\",\"skill_type\":\"普通攻击\",\"icon\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/27/12109492/726f23517c8595c477dd65c987b42482_8499139769805205221.png\",\"life\":1,\"life_bg\":7,\"energy\":2,\"energy_bg\":10,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成2点<strong><u>物理伤害</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;物理伤害：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;物理伤害不会附着元素，也不会发生元素反应。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1756443611493_0\"},{\"tab_name\":\"Movo Lawa\",\"skill_type\":\"元素战技\",\"icon\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/27/12109492/e605c46abaca4c05ff7fcc803d318644_1932728961174964565.png\",\"life\":3,\"life_bg\":7,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成3点<strong><u>物理伤害</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;物理伤害：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;物理伤害不会附着元素，也不会发生元素反应。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1756443611493_1\"},{\"tab_name\":\"Upa Shato\",\"skill_type\":\"元素爆发\",\"icon\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/27/12109492/a63aaedd24cfbefc634b2ac2a77d5f4f_7864871648075602067.png\",\"life\":3,\"life_bg\":7,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成5点<strong><u>物理伤害</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;物理伤害：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;物理伤害不会附着元素，也不会发生元素反应。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1756443611493_2\"},{\"tab_name\":\"魔化：岩盔\",\"skill_type\":\"被动技能\",\"icon\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/27/12109492/60d5501fc29ffb28bc6d2a435b463b2a_6974894146119719968.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>战斗开始时，初始附属<strong><u>岩盔</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;岩盔：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;状态&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;所附属角色受到伤害时：&lt;/strong&gt;抵消1点伤害。抵消&lt;strong&gt;&lt;span style=&quot;color: rgb(212, 107, 8)&quot;&gt;&lt;u&gt;岩元素伤害&lt;/u&gt;&lt;/span&gt;&lt;/strong&gt;时，需额外消耗1次&lt;strong&gt;&lt;u&gt;可用次数&lt;/u&gt;&lt;/strong&gt;。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;可用次数：3&lt;/strong&gt;&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(212, 107, 8)&quot;&gt;岩元素伤害：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;和已附着的元素发生元素反应：&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（冰）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：本伤害+1，我方出战角色获得1点护盾（可叠加，最多2点）。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（水）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：本伤害+1，我方出战角色获得1点护盾（可叠加，最多2点）。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（火）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：本伤害+1，我方出战角色获得1点护盾（可叠加，最多2点）。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（雷）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：本伤害+1，我方出战角色获得1点护盾（可叠加，最多2点）。&lt;/span&gt;&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;可用次数：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;此牌效果触发后，会消耗1次&lt;/span&gt;&lt;strong&gt;&lt;span&gt;可用次数&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;；&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;可用次数&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;耗尽后，立刻弃置此牌。&lt;/span&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>和<strong><u>坚岩之力</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;坚岩之力：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;状态&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;角色造成的&lt;strong&gt;&lt;u&gt;物理伤害&lt;/u&gt;&lt;/strong&gt;变为&lt;strong&gt;&lt;span style=&quot;color: rgb(199, 124, 82)&quot;&gt;&lt;u&gt;岩元素伤害&lt;/u&gt;&lt;/span&gt;&lt;/strong&gt;。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;每回合1次：&lt;/strong&gt;角色造成的伤害+1。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;角色所附属的「岩盔」被移除后：&lt;/strong&gt;也移除此状态。&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;物理伤害：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;物理伤害不会附着元素，也不会发生元素反应。&lt;/span&gt;&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(212, 107, 8)&quot;&gt;岩元素伤害：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;和已附着的元素发生元素反应：&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（冰）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：本伤害+1，我方出战角色获得1点护盾（可叠加，最多2点）。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（水）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：本伤害+1，我方出战角色获得1点护盾（可叠加，最多2点）。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（火）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：本伤害+1，我方出战角色获得1点护盾（可叠加，最多2点）。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（雷）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：本伤害+1，我方出战角色获得1点护盾（可叠加，最多2点）。&lt;/span&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1756443611493_3\"}]}",
          "style": ""
        }
      ],
