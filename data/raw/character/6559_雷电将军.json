          "component_id": "card_skill",
          "layout": "",
          "data": "{\"list\":[{\"tab_name\":\"源流\",\"skill_type\":\"普通攻击\",\"icon\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/27/12109492/0cd68ecb1a011d94e2b4be1b99ac3302_4090150291593632958.png\",\"life\":1,\"life_bg\":5,\"energy\":2,\"energy_bg\":10,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成2点<strong><u>物理伤害</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;物理伤害：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;物理伤害不会附着元素，也不会发生元素反应。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1701085699167_0\"},{\"tab_name\":\"神变·恶曜开眼\",\"skill_type\":\"元素战技\",\"icon\":\"https://act-upload.mihoyo.com/ys-obc/2023/05/16/183046623/ca5a55d164f3a97852b0d7fc59d09875_1236252164045819134.png\",\"life\":3,\"life_bg\":5,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>召唤<strong><em>雷罚恶曜之眼。</em></strong></p>\"]},\"tab_id\":\"1701085699167_1\"},{\"tab_name\":\"奥义·梦想真说\",\"skill_type\":\"元素爆发\",\"icon\":\"https://act-upload.mihoyo.com/ys-obc/2023/05/16/183046623/e32265b2715186774b8d4bcf3d918880_1471851977626289486.png\",\"life\":3,\"life_bg\":5,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成3点<strong><span style=\\\"color: rgb(146, 84, 222)\\\"><u>雷元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(146, 84, 222)&quot;&gt;雷元素伤害：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;附着雷元素，可发生元素反应：&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;超载&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：本伤害+2，目标强制切换到下一个角色&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;超导&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;感电&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;原激化&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：本伤害+1，生成使下2次草元素或雷元素伤害+1的[&lt;/span&gt;&lt;strong&gt;&lt;span&gt;激化领域&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;]&lt;/span&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>，其他我方角色获得2点<strong><u>充能</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;充能：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;角色使用「元素爆发」时，需要消耗充能。&lt;/p&gt;&lt;p&gt;角色使用「元素战技」或「普通攻击」后，会获得1点充能。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1701085699167_2\"},{\"tab_name\":\"诸愿百眼之轮\",\"skill_type\":\"被动技能\",\"icon\":\"https://act-upload.mihoyo.com/ys-obc/2023/05/16/183046623/2df2771f98519d3d46ad0551977ca99a_7788585308123167206.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>【被动】战斗开始时，初始附属<strong><u>诸愿百眼之轮</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;诸愿百眼之轮：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;状态&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;其他我方角色使用「元素爆发」后：&lt;/strong&gt;累积1点&lt;strong&gt;「愿力」&lt;/strong&gt;。（最多累积3点）&lt;/p&gt;&lt;p&gt;&lt;strong&gt;所附属角色使用奥义·梦想真说时：&lt;/strong&gt;消耗所有&lt;strong&gt;「愿力」&lt;/strong&gt;，每点&lt;strong&gt;「愿力」&lt;/strong&gt;使造成的伤害+1。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1701085699167_3\"}]}",
