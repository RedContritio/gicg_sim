      "components": [
        {
          "component_id": "card_skill",
          "layout": "",
          "data": "{\"moduleName\":\"卡牌技能\",\"layout_\":\"right\",\"list\":[{\"tab_name\":\"叶轮轻扫\",\"skill_type\":\"普通攻击\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/10/08/258999284/06e3bf5c09e70fc238f4d8add6312171_2981806382445103072.png\",\"life\":1,\"life_bg\":2,\"energy\":2,\"energy_bg\":10,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成2点<strong><u>物理伤害</u></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>物理伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>物理伤害不会附着元素，也不会发生元素反应。</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1694067287681_0\"},{\"tab_name\":\"蔓延旋舞\",\"skill_type\":\"元素战技\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/10/08/258999284/d69cd6abad732aa60170bc087993b671_5098242204074695402.png\",\"life\":3,\"life_bg\":2,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成3点<strong><span style=\\\"color: rgb(82, 196, 26)\\\"><u>草元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>草元素伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>附着草元素，可发生元素反应：</p><p style=&quot;white-space: pre-wrap;&quot;><strong>绽放</strong>：本伤害+1，生成使下次火/雷伤害＋2的[<strong>草原核</strong>]</p><p style=&quot;white-space: pre-wrap;&quot;><strong>燃烧</strong>：本伤害+1，生成回合结束时造成1点火伤害的[<strong>燃烧烈焰</strong>]（可生效1次，最多叠加到2次）</p><p style=&quot;white-space: pre-wrap;&quot;><strong>原激化</strong>：本伤害+1，生成使下2次草/雷伤害+1的[<strong>激化领域</strong>]</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，生成1层</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>灵蛇祝福</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>灵蛇祝福：</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>出战状态</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>我方使用厄灵·草之灵蛇的特技</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>时：此</span><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>特技</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>造成的伤害+1，并且不消耗厄灵·草之灵蛇的</span><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>可用次数</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>。</span></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>可用次数：1（可叠加，没有上限）</span></strong></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">。</span></p>\"]},\"tab_id\":\"1728389817596_1\"},{\"tab_name\":\"厄灵苏醒·草之灵蛇\",\"skill_type\":\"元素爆发\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/10/08/258999284/96b81cdc1ce8dfac226116c9fe43992a_2705445042404454391.png\",\"life\":3,\"life_bg\":2,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成4点<strong><span style=\\\"color: rgb(82, 196, 26)\\\"><u>草元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>草元素伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>附着草元素，可发生元素反应：</p><p style=&quot;white-space: pre-wrap;&quot;><strong>绽放</strong>：本伤害+1，生成使下次火/雷伤害＋2的[<strong>草原核</strong>]</p><p style=&quot;white-space: pre-wrap;&quot;><strong>燃烧</strong>：本伤害+1，生成回合结束时造成1点火伤害的[<strong>燃烧烈焰</strong>]（可生效1次，最多叠加到2次）</p><p style=&quot;white-space: pre-wrap;&quot;><strong>原激化</strong>：本伤害+1，生成使下2次草/雷伤害+1的[<strong>激化领域</strong>]</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>，<span style=\\\"color: rgb(0, 0, 0)\\\">整场牌局限制1次，将1张</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>厄灵·草之灵蛇</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>厄灵·草之灵蛇</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>装备牌</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>费用：0</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>特技</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>：藤蔓锋鳞</span></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>可用次数：</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>2</span></p><p><span style=&quot;color: rgb(0, 0, 0)&quot;>（角色最多装备1个「特技」）</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">加入我方手牌。<br>（装备有</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>厄灵·草之灵蛇</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>厄灵·草之灵蛇</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>装备牌</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>费用：0</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>特技</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>：藤蔓锋鳞</span></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>可用次数：</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>2</span></p><p><span style=&quot;color: rgb(0, 0, 0)&quot;>（角色最多装备1个「特技」）</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">的角色可以使用特技：</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>藤蔓锋鳞</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong>藤蔓锋鳞：</strong></p><p><strong>特技</strong></p><p><strong>费用：1+1点充能</strong></p><p>造成1点<strong><span style=&quot;color: rgb(126, 194, 54)&quot;>草元素伤害</span></strong>。</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">）</span></p>\"]},\"tab_id\":\"1728389964874_2\"},{\"tab_name\":\"厄灵之能\",\"skill_type\":\"被动技能\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/10/08/258999284/6f2fc1e2e7ad6747577d954f3db9012f_2120144226908224970.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p><span style=\\\"color: rgb(0, 0, 0)\\\">【被动】</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\">此角色受到伤害后：</span></strong><span style=\\\"color: rgb(0, 0, 0)\\\">如果此角色生命值不多于7，则获得1点</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\">充能</span></strong><span style=\\\"color: rgb(0, 0, 0)\\\">。（每回合1次）</span></p>\"]},\"tab_id\":\"1728390448217_3\"}]}",
          "style": ""
        }
