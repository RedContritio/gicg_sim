          "component_id": "card_skill",
          "layout": "",
          "data": "{\"list\":[{\"tab_name\":\"西风剑术\",\"skill_type\":\"普通攻击\",\"icon\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/27/12109492/2bfbf024135461849666339c43d60b2c_990445751645542375.png\",\"life\":1,\"life_bg\":3,\"energy\":2,\"energy_bg\":10,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成2点<strong><u>物理伤害</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;物理伤害：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;物理伤害不会附着元素，也不会发生元素反应。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1701823273337_0\"},{\"tab_name\":\"风压剑\",\"skill_type\":\"元素战技\",\"icon\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/27/12109492/68d6fd8c9815617b0491dd19586ae2f4_2703229586151516906.png\",\"life\":3,\"life_bg\":3,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成3点<strong><span style=\\\"color: rgb(54, 207, 201)\\\"><u>风元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(54, 207, 201)&quot;&gt;风元素伤害：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;和已附着的元素发生元素反应：&lt;/p&gt;&lt;p&gt;&lt;strong&gt;扩散（冰）：&lt;/strong&gt;对目标以外的所有敌方角色造成1点冰元素伤害&lt;/p&gt;&lt;p&gt;&lt;strong&gt;扩散（水）：&lt;/strong&gt;对目标以外的所有敌方角色造成1点水元素伤害&lt;/p&gt;&lt;p&gt;&lt;strong&gt;扩散（火）：&lt;/strong&gt;对目标以外的所有敌方角色造成1点火元素伤害&lt;/p&gt;&lt;p&gt;&lt;strong&gt;扩散（雷）：&lt;/strong&gt;对目标以外的所有敌方角色造成1点雷元素伤害&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>，使对方强制切换到下一个角色。</p>\"]},\"tab_id\":\"1701823273337_1\"},{\"tab_name\":\"蒲公英之风\",\"skill_type\":\"元素爆发\",\"icon\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/27/12109492/e4d3dd465a4f6026ba923619c1827c94_3960747061292563787.png\",\"life\":4,\"life_bg\":3,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>治疗我方所有角色2点，召唤<strong><em>蒲公英领域</em></strong>。</p>\"]},\"tab_id\":\"1701823273337_2\"}]}",
