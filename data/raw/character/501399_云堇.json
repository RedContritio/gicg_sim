      "components": [
        {
          "component_id": "card_skill",
          "layout": "",
          "data": "{\"moduleName\":\"卡牌技能\",\"layout_\":\"right\",\"list\":[{\"tab_name\":\"旋云开相\",\"skill_type\":\"元素战技\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/22/258999284/9653b6a5d3fda17c3e8443962584b311_3621204675186959924.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>蓄力</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;蓄力：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;完成对应次数的蓄力行动后，才能释放对应技能。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><strong><span style=\\\"color: rgb(0, 0, 0)\\\">1次后：</span></strong>造成<strong><span style=\\\"color: rgb(212, 177, 6)\\\"><u>岩元素伤害</u></span></strong><span style=\\\"color: rgb(255, 169, 64)\\\"><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(212, 177, 6)&quot;&gt;岩元素伤害：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;和已附着的元素发生元素反应&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;每点&lt;/span&gt;&lt;strong&gt;&lt;span&gt;元素精通&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;使&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;特定效果&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;提升1倍。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（冰）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：生成&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;3&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;点护盾。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（火）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：生成&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;3&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;点护盾。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（水）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：生成&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;3&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;点护盾。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（雷）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：生成&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;3&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;点护盾。&lt;/span&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span></span><span style=\\\"color: rgb(0, 0, 0)\\\">。</span></p>\"]},\"tab_id\":\"1730815714102_0\"},{\"tab_name\":\"破嶂见旌仪\",\"skill_type\":\"元素爆发\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/22/258999284/289c56363620f16b7372fc097b9a9883_5923478129039454000.png\",\"life\":2,\"life_bg\":8,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成<strong><span style=\\\"color: rgb(212, 177, 6)\\\"><u>岩元素伤害</u></span></strong><span style=\\\"color: rgb(255, 169, 64)\\\"><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(212, 177, 6)&quot;&gt;岩元素伤害：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;和已附着的元素发生元素反应&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;每点&lt;/span&gt;&lt;strong&gt;&lt;span&gt;元素精通&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;使&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;特定效果&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;提升1倍。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（冰）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：生成&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;3&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;点护盾。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（火）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：生成&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;3&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;点护盾。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（水）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：生成&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;3&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;点护盾。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;结晶（雷）&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;：生成&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;3&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;点护盾。&lt;/span&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span></span>，<span style=\\\"color: rgb(0, 0, 0)\\\">下一名我方角色附属1层</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>飞云旗阵</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;飞云旗阵：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;状态&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;附属角色行动后：&lt;u&gt;额外行动&lt;/u&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;1次。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;&lt;u&gt;可用次数&lt;/u&gt;：1&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;（可叠加，没有上限）&lt;/span&gt;&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;额外行动：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;角色不会因为额外行动而获得充能。&lt;/span&gt;&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;可用次数：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;此牌效果触发后，会消耗1次&lt;/span&gt;&lt;strong&gt;&lt;span&gt;可用次数&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;；&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span&gt;可用次数&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;耗尽后，立刻弃置此牌。&lt;/span&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1732208442763_1\"},{\"tab_name\":\"蓄力护盾+\",\"skill_type\":\"被动技能\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/07/258999284/ee8e0f74e7d2b2f407fd37376c8b63a8_512284338505892228.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>自身进行<strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>蓄力</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;蓄力：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;完成对应次数的蓄力行动后，才能释放对应技能。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>后：附属2层<strong><u>免疫伤害</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;免疫伤害：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;状态&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;每层使得角色下次受到的伤害为0（可叠加，没有上限）。 &lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span></p>\"]},\"tab_id\":\"1746581132866_2\"}],\"baseInfoSwitchDisabled\":false}",
