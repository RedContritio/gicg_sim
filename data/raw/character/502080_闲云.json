      "components": [
        {
          "component_id": "card_skill",
          "layout": "",
          "data": "{\"moduleName\":\"卡牌技能\",\"layout_\":\"right\",\"list\":[{\"tab_name\":\"清风散花词\",\"skill_type\":\"普通攻击\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/27/258999284/eb080e7a8d04826c0ebf08bbf5d3f0c7_38999773952277972.png\",\"life\":1,\"life_bg\":3,\"energy\":2,\"energy_bg\":10,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p><span style=\\\"color: rgb(0, 0, 0)\\\">造成1点</span><strong><span style=\\\"color: rgb(54, 207, 201)\\\"><u>风元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>风元素伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>和已附着的元素发生元素反应：</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（冰）：对目标以外的所有敌方角色造成1点冰伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（水）：对目标以外的所有敌方角色造成1点水伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（火）：对目标以外的所有敌方角色造成1点火伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（雷）：对目标以外的所有敌方角色造成1点雷伤害</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">。</span></p>\"]},\"tab_id\":\"1694067287681_0\"},{\"tab_name\":\"朝起鹤云\",\"skill_type\":\"元素战技\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/27/258999284/1914d2cb4199cd49e28604f105b1e57d_5159935908470746953.png\",\"life\":3,\"life_bg\":3,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p><span style=\\\"color: rgb(0, 0, 0)\\\">造成1点</span><strong><span style=\\\"color: rgb(54, 207, 201)\\\"><u>风元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>风元素伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>和已附着的元素发生元素反应：</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（冰）：对目标以外的所有敌方角色造成1点冰伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（水）：对目标以外的所有敌方角色造成1点水伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（火）：对目标以外的所有敌方角色造成1点火伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（雷）：对目标以外的所有敌方角色造成1点雷伤害</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，生成</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>步天梯</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>步天梯：</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>出战状态</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>我方执行「切换角色」行动时：</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>少花费1个元素骰。</span></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>可用次数：1（可叠加，最多叠加到2次）</span></strong></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，本角色附属</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>闲云冲击波</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>闲云冲击波：</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>状态</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>我方切换到所附属角色后：</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>造成1点</span><strong><span style=&quot;color: rgb(19, 194, 194)&quot;>风元素伤害</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>。</span></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>可用次数：1（可叠加，最多叠加到2次）</span></strong></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">。</span></p>\"]},\"tab_id\":\"1724760792245_1\"},{\"tab_name\":\"暮集竹星\",\"skill_type\":\"元素爆发\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/27/258999284/9defe82ef629b59ef3c373d3ba64e492_2031181392714657327.png\",\"life\":3,\"life_bg\":3,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p><span style=\\\"color: rgb(0, 0, 0)\\\">造成1点</span><strong><span style=\\\"color: rgb(54, 207, 201)\\\"><u>风元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>风元素伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>和已附着的元素发生元素反应：</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（冰）：对目标以外的所有敌方角色造成1点冰伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（水）：对目标以外的所有敌方角色造成1点水伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（火）：对目标以外的所有敌方角色造成1点火伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（雷）：对目标以外的所有敌方角色造成1点雷伤害</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，治疗所有我方角色1点，生成手牌</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>竹星</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong>竹星：</strong></p><p><strong>装备牌</strong></p><p><strong>费用：0</strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>特技：仙力助推</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>可用次数</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>：2</span></p><p><span style=&quot;color: rgb(0, 0, 0)&quot;>（角色最多装备1个「特技」）</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">。<br>（装备有</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>竹星</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong>竹星：</strong></p><p><strong>装备牌</strong></p><p><strong>费用：0</strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>特技：仙力助推</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>可用次数</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>：2</span></p><p><span style=&quot;color: rgb(0, 0, 0)&quot;>（角色最多装备1个「特技」）</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">的角色可以使用特技：</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>仙力助推</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong>仙力助推：</strong></p><p><strong>特技</strong></p><p><strong>费用：</strong>1</p><p>治疗所附属角色2点，并使其下次普通攻击视为<strong>下落攻击</strong>，伤害+1并且技能结算后造成1点<strong><span style=&quot;color: rgb(19, 194, 194)&quot;>风元素伤害</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>。</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">）</span></p>\"]},\"tab_id\":\"1724760794278_2\"}]}",
          "style": ""
        }
      ],
