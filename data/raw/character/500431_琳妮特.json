          "component_id": "card_skill",
          "layout": "",
          "data": "{\"moduleName\":\"卡牌技能\",\"layout_\":\"right\",\"list\":[{\"tab_name\":\"迅捷礼刺剑\",\"skill_type\":\"普通攻击\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/19/258999284/b5ebc228f47c5f250990118953db65bd_7349976466082395364.png\",\"life\":1,\"life_bg\":3,\"energy\":2,\"energy_bg\":10,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成2点<strong><u>物理伤害</u></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>物理伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>物理伤害不会附着元素，也不会发生元素反应。</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1694067287681_0\"},{\"tab_name\":\"谜影障身法\",\"skill_type\":\"元素战技\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/19/258999284/2d696e8b97e9fe9fb4572a81786780d6_2735599059161740228.png\",\"life\":3,\"life_bg\":3,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成3点<strong><span style=\\\"color: rgb(54, 207, 201)\\\"><u>风元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>风元素伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>和已附着的元素发生元素反应：</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（冰）：对目标以外的所有敌方角色造成1点冰伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（水）：对目标以外的所有敌方角色造成1点水伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（火）：对目标以外的所有敌方角色造成1点火伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（雷）：对目标以外的所有敌方角色造成1点雷伤害</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，本回合第一次使用此技能、且自身生命值不多于8时治疗自身2点，但是附属</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>攻袭余威</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>攻袭余威：</span></strong></p><p><span style=&quot;color: rgb(0, 0, 0)&quot;>状态</span></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>结束阶段：</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>如果角色生命值至少为6，则受到2点</span><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>穿透伤害</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>。</span></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>持续回合</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>：1</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">。</span></p>\"]},\"tab_id\":\"1703000539577_1\"},{\"tab_name\":\"魔术·运变惊奇\",\"skill_type\":\"元素爆发\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/19/258999284/6f97ce81f1862b031947b8a82ec8c680_8034117038151757666.png\",\"life\":3,\"life_bg\":3,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成2点<strong><span style=\\\"color: rgb(54, 207, 201)\\\"><u>风元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>风元素伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>和已附着的元素发生元素反应：</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（冰）：对目标以外的所有敌方角色造成1点冰伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（水）：对目标以外的所有敌方角色造成1点水伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（火）：对目标以外的所有敌方角色造成1点火伤害</p><p style=&quot;white-space: pre-wrap;&quot;>扩散（雷）：对目标以外的所有敌方角色造成1点雷伤害</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，召唤</span><strong><em><span style=\\\"color: rgb(0, 0, 0)\\\">惊奇猫猫盒</span></em></strong><span style=\\\"color: rgb(0, 0, 0)\\\">。</span></p>\"]},\"tab_id\":\"1703000884792_2\"}]}",
