      "components": [
        {
          "component_id": "card_skill",
          "layout": "",
          "data": "{\"moduleName\":\"卡牌技能\",\"layout_\":\"right\",\"list\":[{\"tab_name\":\"鳄齿锐波\",\"skill_type\":\"元素战技\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/02/11/258999284/c357668a3d1a749e4003f578687c54c7_8666737310344464188.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成<strong><span style=\\\"color: rgb(24, 144, 255)\\\"><u>水元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(24, 144, 255)&quot;&gt;水元素伤害：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;附着水元素，可发生元素反应&lt;/p&gt;&lt;p&gt;每点&lt;strong&gt;元素精通&lt;/strong&gt;使&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;特定效果&lt;/span&gt;&lt;/strong&gt;提升1倍。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;蒸发：&lt;/strong&gt;本伤害翻倍，每8点&lt;strong&gt;元素精通&lt;/strong&gt;额外翻1倍&lt;/p&gt;&lt;p&gt;&lt;strong&gt;感电：&lt;/strong&gt;所有敌方角色受到&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;1&lt;/span&gt;&lt;/strong&gt;点穿透伤害&lt;/p&gt;&lt;p&gt;&lt;strong&gt;冻结：&lt;/strong&gt;目标附属&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;4&lt;/span&gt;&lt;/strong&gt;层&lt;strong&gt;冻伤&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;绽放：&lt;/strong&gt;生成&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;1&lt;/span&gt;&lt;/strong&gt;层&lt;strong&gt;草原核&lt;/strong&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1730815714102_0\"},{\"tab_name\":\"凶鳄狂浪\",\"skill_type\":\"元素爆发\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/02/11/258999284/261dce21bdb6e5cc2e0161f88538979c_2126152053723761736.png\",\"life\":0,\"life_bg\":0,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成2倍攻击力的<strong><span style=\\\"color: rgb(24, 144, 255)\\\"><u>水元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(24, 144, 255)&quot;&gt;水元素伤害：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;附着水元素，可发生元素反应&lt;/p&gt;&lt;p&gt;每点&lt;strong&gt;元素精通&lt;/strong&gt;使&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;特定效果&lt;/span&gt;&lt;/strong&gt;提升1倍。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;蒸发：&lt;/strong&gt;本伤害翻倍，每8点&lt;strong&gt;元素精通&lt;/strong&gt;额外翻1倍&lt;/p&gt;&lt;p&gt;&lt;strong&gt;感电：&lt;/strong&gt;所有敌方角色受到&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;1&lt;/span&gt;&lt;/strong&gt;点穿透伤害&lt;/p&gt;&lt;p&gt;&lt;strong&gt;冻结：&lt;/strong&gt;目标附属&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;4&lt;/span&gt;&lt;/strong&gt;层&lt;strong&gt;冻伤&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;绽放：&lt;/strong&gt;生成&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;1&lt;/span&gt;&lt;/strong&gt;层&lt;strong&gt;草原核&lt;/strong&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>，<strong><u>舍弃</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;舍弃：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;通过行动牌或角色技能的效果，将行动牌从手牌或牌库中弃置。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>手牌中的<strong><u>噬骸能量块</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;噬骸能量块：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;费用：0&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;事件牌&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;选一个我方角色+2攻击力。&lt;/p&gt;&lt;p&gt;被弃置时：我方全体圣骸兽+1攻击力。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1739249996656_1\"},{\"tab_name\":\"圣骸感应\",\"skill_type\":\"被动技能\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/02/11/258999284/b539b03ea17283551f0c25327826656a_224956877266432226.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"\",\"value\":[\"<p>【被动】我方打出或是<strong><u>舍弃</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;舍弃：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;通过行动牌或角色技能的效果，将行动牌从手牌或牌库中弃置。 &lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><strong><u>噬骸能量块</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;噬骸能量块：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;费用：0&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;事件牌&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;选一个我方角色+2攻击力。&lt;/p&gt;&lt;p&gt;被弃置时：我方全体圣骸兽+1攻击力。&lt;/p&gt;&lt;p&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>时，+2最大生命值。</p>\"]},\"tab_id\":\"1739250232835_2\"}],\"baseInfoSwitchDisabled\":false}",
          "style": ""
        }
      ],
