      "components": [
        {
          "component_id": "card_skill",
          "layout": "",
          "data": "{\"moduleName\":\"卡牌技能\",\"layout_\":\"right\",\"list\":[{\"tab_name\":\"祛风妙仪\",\"skill_type\":\"普通攻击\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/21/258999284/efa17ee475d867bbddf3792363705cf4_5624824579077078623.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p><span style=\\\"color: rgb(0, 0, 0)\\\">造成1点</span><strong><span style=\\\"color: rgb(54, 207, 201)\\\"><u>风元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;风元素伤害：&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;和已附着的元素发生元素反应：&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（冰）：对目标以外的所有敌方角色造成1点冰伤害&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（水）：对目标以外的所有敌方角色造成1点水伤害&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（火）：对目标以外的所有敌方角色造成1点火伤害&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（雷）：对目标以外的所有敌方角色造成1点雷伤害&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1694067287681_0\"},{\"tab_name\":\"空天疾护\",\"skill_type\":\"元素战技\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/21/258999284/b2d1b7b516530565e722ded4abf10751_7101356055499665736.png\",\"life\":2,\"life_bg\":3,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p><span style=\\\"color: rgb(0, 0, 0)\\\">造成1点</span><strong><span style=\\\"color: rgb(54, 207, 201)\\\"><u>风元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;风元素伤害：&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;和已附着的元素发生元素反应：&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（冰）：对目标以外的所有敌方角色造成1点冰伤害&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（水）：对目标以外的所有敌方角色造成1点水伤害&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（火）：对目标以外的所有敌方角色造成1点火伤害&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（雷）：对目标以外的所有敌方角色造成1点雷伤害&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，自身进入</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>夜魂加持</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;夜魂加持：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;所附属角色可累积&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;「夜魂值」&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;。（最多累积到2点）&lt;br&gt;&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;持续回合：2&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">获得2点</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\">「夜魂值」</span></strong><span style=\\\"color: rgb(0, 0, 0)\\\">，并附属</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>咔库库</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;咔库库：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;装备牌&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;特技：援护射击&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;所附属角色&lt;strong&gt;「夜魂值」&lt;/strong&gt;为0时，弃置此牌；此牌被弃置时，所附属角色结束&lt;strong&gt;夜魂加持&lt;/strong&gt;。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">。（角色进入</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\">夜魂加持</span></strong><span style=\\\"color: rgb(0, 0, 0)\\\">后不可使用此技能）</span></p><p><span style=\\\"color: rgb(0, 0, 0)\\\">（附属</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\">咔库库</span></strong><span style=\\\"color: rgb(0, 0, 0)\\\">的角色可以使用特技：</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>援护射击</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;援护射击：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;特技&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;费用：2&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;消耗1点&lt;strong&gt;「夜魂值」&lt;/strong&gt;，对上一个敌方角色&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;造成1点&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(54, 207, 201)&quot;&gt;&lt;u&gt;风元素伤害&lt;/u&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span data-type=&quot;详情&quot; data-name=&quot;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;风元素伤害：&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;和已附着的元素发生元素反应：&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（冰）：对目标以外的所有敌方角色造成1点冰伤害&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（水）：对目标以外的所有敌方角色造成1点水伤害&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（火）：对目标以外的所有敌方角色造成1点火伤害&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（雷）：对目标以外的所有敌方角色造成1点雷伤害&lt;/p&gt;&quot; class=&quot;wiki-note-text&quot;&gt;&lt;sup class=&quot;wiki-sup&quot;&gt;[详情]&lt;/sup&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;，并治疗我方受伤最多的角色2点。&lt;/span&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">）</span></p>\"]},\"tab_id\":\"1760979396313_1\"},{\"tab_name\":\"复合镇静域\",\"skill_type\":\"元素爆发\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/21/258999284/0179cb3d8dc090c33ea8dcb1f2f23367_6900272809255141821.png\",\"life\":3,\"life_bg\":3,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p><span style=\\\"color: rgb(0, 0, 0)\\\">造成2点</span><strong><span style=\\\"color: rgb(54, 207, 201)\\\"><u>风元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;风元素伤害：&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;和已附着的元素发生元素反应：&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（冰）：对目标以外的所有敌方角色造成1点冰伤害&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（水）：对目标以外的所有敌方角色造成1点水伤害&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（火）：对目标以外的所有敌方角色造成1点火伤害&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;扩散（雷）：对目标以外的所有敌方角色造成1点雷伤害&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，治疗我方受伤最多的角色2点。如果此技能引发了</span><strong><span style=\\\"color: rgb(19, 194, 194)\\\"><u>风元素相关反应</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;风元素相关反应：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;扩散（冰）&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;：对目标以外的所有敌方角色造成1点冰元素伤害。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;扩散（水）&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;：对目标以外的所有敌方角色造成1点水元素伤害。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;扩散（火）&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;：对目标以外的所有敌方角色造成1点火元素伤害。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;扩散（雷）&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;：对目标以外的所有敌方角色造成1点雷元素伤害。&lt;/span&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，则敌方出战角色附属对应元素的</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>镇静标记</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;镇静标记：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;状态&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0)&quot;&gt;所在阵营选择行动前：&lt;/span&gt;&lt;/strong&gt;对所附属的角色造成2点对应元素伤害，可用次数1。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">。</span></p>\"]},\"tab_id\":\"1760980434894_2\"}],\"baseInfoSwitchDisabled\":false}",
          "style": ""
        }
      ],
