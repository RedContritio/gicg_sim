      "components": [
        {
          "component_id": "card_skill",
          "layout": "",
          "data": "{\"moduleName\":\"卡牌技能\",\"layout_\":\"right\",\"list\":[{\"tab_name\":\"失乡重击\",\"skill_type\":\"普通攻击\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/04/258999284/52c75cdc2bfe940c74ce53c016e70485_8098108794860404957.png\",\"life\":1,\"life_bg\":2,\"energy\":2,\"energy_bg\":10,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成2点<strong><u>物理伤害</u></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>物理伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>物理伤害不会附着元素，也不会发生元素反应。</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1694067287681_0\"},{\"tab_name\":\"生命流束\",\"skill_type\":\"元素战技\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/04/258999284/6b6af66686864e881e180633491577b7_1337053029698647969.png\",\"life\":3,\"life_bg\":2,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成2点<strong><span style=\\\"color: rgb(82, 196, 26)\\\"><u>草元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>草元素伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>附着草元素，可发生元素反应：</p><p style=&quot;white-space: pre-wrap;&quot;><strong>绽放</strong>：本伤害+1，生成使下次火/雷伤害＋2的[<strong>草原核</strong>]</p><p style=&quot;white-space: pre-wrap;&quot;><strong>燃烧</strong>：本伤害+1，生成回合结束时造成1点火伤害的[<strong>燃烧烈焰</strong>]（可生效1次，最多叠加到2次）</p><p style=&quot;white-space: pre-wrap;&quot;><strong>原激化</strong>：本伤害+1，生成使下2次草/雷伤害+1的[<strong>激化领域</strong>]</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，抓1张</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>唤醒眷属</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong>唤醒眷属：</strong></p><p><strong>事件牌</strong></p><p><strong>费用：</strong>2个<strong><span style=&quot;color: rgb(82, 196, 26)&quot;>草元素</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>打出此牌或舍弃</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>此牌时：召唤一个独立的</span><strong><em><span style=&quot;color: rgb(0, 0, 0)&quot;>增殖生命体</span></em></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>。</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，生成1层</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>绿洲之滋养</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong>绿洲之滋养：</strong></p><p>出战状态</p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>我方打出唤醒眷属时：</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>少花费1个元素骰。</span><br><strong><span style=&quot;color: rgb(255, 255, 255)&quot;>可用次数：1（可叠加到3）</span></strong></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">。</span></p>\"]},\"tab_id\":\"1717477179744_1\"},{\"tab_name\":\"终景迸落\",\"skill_type\":\"元素爆发\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/04/258999284/67a564cb356fc0cfddb1f98658d35573_3718187889744663164.png\",\"life\":3,\"life_bg\":2,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成4点<strong><span style=\\\"color: rgb(82, 196, 26)\\\"><u>草元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p style=&quot;white-space: pre-wrap;&quot;>草元素伤害：</p><p style=&quot;white-space: pre-wrap;&quot;>附着草元素，可发生元素反应：</p><p style=&quot;white-space: pre-wrap;&quot;><strong>绽放</strong>：本伤害+1，生成使下次火/雷伤害＋2的[<strong>草原核</strong>]</p><p style=&quot;white-space: pre-wrap;&quot;><strong>燃烧</strong>：本伤害+1，生成回合结束时造成1点火伤害的[<strong>燃烧烈焰</strong>]（可生效1次，最多叠加到2次）</p><p style=&quot;white-space: pre-wrap;&quot;><strong>原激化</strong>：本伤害+1，生成使下2次草/雷伤害+1的[<strong>激化领域</strong>]</p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，抓1张</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>唤醒眷属</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong>唤醒眷属：</strong></p><p><strong>事件牌</strong></p><p><strong>费用：</strong>2个<strong><span style=&quot;color: rgb(82, 196, 26)&quot;>草元素</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>打出此牌或舍弃</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>此牌时：召唤一个独立的</span><strong><em><span style=&quot;color: rgb(0, 0, 0)&quot;>增殖生命体</span></em></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>。</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，生成2层</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>绿洲之滋养</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong>绿洲之滋养：</strong></p><p>出战状态</p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>我方打出唤醒眷属时：</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>少花费1个元素骰。</span><br><strong><span style=&quot;color: rgb(255, 255, 255)&quot;>可用次数：1（可叠加到3）</span></strong></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">。</span></p>\"]},\"tab_id\":\"1717477451236_2\"},{\"tab_name\":\"增殖感召\",\"skill_type\":\"被动技能\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/04/258999284/d5084bf33845c72c75d6b590a21b3f93_3778267969787494418.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p><span style=\\\"color: rgb(0, 0, 0)\\\">【被动】战斗开始时，生成5张</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>唤醒眷属</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong>唤醒眷属：</strong></p><p><strong>事件牌</strong></p><p><strong>费用：</strong>2个<strong><span style=&quot;color: rgb(82, 196, 26)&quot;>草元素</span></strong></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>打出此牌或舍弃</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>此牌时：召唤一个独立的</span><strong><em><span style=&quot;color: rgb(0, 0, 0)&quot;>增殖生命体</span></em></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>。</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，随机放入牌库。我方召唤4个</span><strong><em><span style=\\\"color: rgb(0, 0, 0)\\\">增殖生命体</span></em></strong><span style=\\\"color: rgb(0, 0, 0)\\\">后，此角色附属</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>重燃的绿洲之心</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>重燃的绿洲之心：</span></strong></p><p>状态</p><p><span style=&quot;color: rgb(0, 0, 0)&quot;>所附属角色造成的伤害+3。</span></p><p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>所附属角色使用技能后：</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>移除我方场上的</span><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>绿洲之滋养</span></strong><span style=&quot;color: rgb(0, 0, 0)&quot;>，每移除1层就治疗所附属角色1点。</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">，并获得1点</span><strong><span style=\\\"color: rgb(0, 0, 0)\\\"><u>护盾</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"<p><strong><span style=&quot;color: rgb(0, 0, 0)&quot;>护盾：</span></strong></p><p><span style=&quot;color: rgb(0, 0, 0)&quot;>此护盾所保护的角色受到伤害时，将会消耗护盾来抵消伤害。</span></p>\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span><span style=\\\"color: rgb(0, 0, 0)\\\">。</span></p>\"]},\"tab_id\":\"1717477521505_3\"}]}",
