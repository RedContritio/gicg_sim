      "components": [
        {
          "component_id": "card_skill",
          "layout": "",
          "data": "{\"moduleName\":\"卡牌技能\",\"layout_\":\"right\",\"list\":[{\"tab_name\":\"识果种雷\",\"skill_type\":\"元素战技\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/22/258999284/2c6ed232f35902bac751007dfa939cd5_1801298058867868449.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>造成<strong><span style=\\\"color: rgb(82, 196, 26)\\\"><u>草元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(82, 196, 26)&quot;&gt;草元素伤害：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;附着草元素，可发生元素反应&lt;/p&gt;&lt;p&gt;每点&lt;strong&gt;元素精通&lt;/strong&gt;使&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;特定效果&lt;/span&gt;&lt;/strong&gt;提升1倍。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;绽放：&lt;/strong&gt;生成&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;1&lt;/span&gt;&lt;/strong&gt;层&lt;strong&gt;草原核&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;燃烧：&lt;/strong&gt;目标附属&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;1&lt;/span&gt;&lt;/strong&gt;层[&lt;strong&gt;持续燃烧&lt;/strong&gt;]&lt;/p&gt;&lt;p&gt;&lt;strong&gt;原激化：&lt;/strong&gt;生成2层[&lt;strong&gt;激化领域&lt;/strong&gt;]，最多叠加&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;2&lt;/span&gt;&lt;/strong&gt;层&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>，召唤2层<strong><em>藏蕴花矢</em></strong>。</p>\"]},\"tab_id\":\"1730815714102_0\"},{\"tab_name\":\"造生缠藤箭\",\"skill_type\":\"元素爆发\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/22/258999284/417d1805fd1254e78a4b04530e33e066_3134085332948259900.png\",\"life\":3,\"life_bg\":8,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>对所有敌方角色造成<strong><span style=\\\"color: rgb(82, 196, 26)\\\"><u>草元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(82, 196, 26)&quot;&gt;草元素伤害：&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;附着草元素，可发生元素反应&lt;/p&gt;&lt;p&gt;每点&lt;strong&gt;元素精通&lt;/strong&gt;使&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;特定效果&lt;/span&gt;&lt;/strong&gt;提升1倍。&lt;/p&gt;&lt;p&gt;&lt;strong&gt;绽放：&lt;/strong&gt;生成&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;1&lt;/span&gt;&lt;/strong&gt;层&lt;strong&gt;草原核&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;燃烧：&lt;/strong&gt;目标附属&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;1&lt;/span&gt;&lt;/strong&gt;层[&lt;strong&gt;持续燃烧&lt;/strong&gt;]&lt;/p&gt;&lt;p&gt;&lt;strong&gt;原激化：&lt;/strong&gt;生成2层[&lt;strong&gt;激化领域&lt;/strong&gt;]，最多叠加&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;2&lt;/span&gt;&lt;/strong&gt;层&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]},\"tab_id\":\"1732209680422_1\"},{\"tab_name\":\"自行：元素精通提升\",\"skill_type\":\"被动技能\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/07/258999284/406c5487cdcd37f638499c571f1868f5_5941099500500494943.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p>【被动】我方<strong><u>元素精通</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p&gt;&lt;strong&gt;元素精通：&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;每点元素精通使得敌方受到的元素反应中&lt;strong&gt;&lt;span style=&quot;color: rgb(250, 219, 20)&quot;&gt;特定效果&lt;/span&gt;&lt;/strong&gt;提升1倍。 &lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>+1。</p>\"]},\"tab_id\":\"1746581883070_2\"}],\"baseInfoSwitchDisabled\":false}",
