        {
          "component_id": "card_skill",
          "layout": "",
          "data": "{\"list\":[{\"tab_name\":\"雷弹\",\"skill_type\":\"普通攻击\",\"icon\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/12/183046623/0f451842885c44779d882c9ced0b9b09_799080124835198330.jpg\",\"life\":1,\"life_bg\":5,\"energy\":2,\"energy_bg\":10,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p style=\\\"white-space: pre-wrap;\\\">造成1点<strong><span style=\\\"color:rgba(146,84,222,1)\\\"><u>雷元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;雷元素伤害：&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;附着雷元素，可发生元素反应：&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;超载&lt;/strong&gt;：本伤害+2，目标强制切换到下一个角色&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;超导&lt;/strong&gt;：本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;感电&lt;/strong&gt;：本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;原激化&lt;/strong&gt;：本伤害+1，生成使下2次草/雷伤害+1的[&lt;strong&gt;激化领域&lt;/strong&gt;]&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]}},{\"tab_name\":\"缠光的祭法\",\"skill_type\":\"元素战技\",\"icon\":\"https://act-upload.mihoyo.com/ys-obc/2023/05/16/183046623/45449915972843191a2d0cfb1239752a_4624255515541188555.png\",\"life\":3,\"life_bg\":5,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p style=\\\"white-space: pre-wrap;\\\">召唤<strong><em>缠雷之环</em></strong>。</p>\"]}},{\"tab_name\":\"滚雷驰骤之仪\",\"skill_type\":\"元素爆发\",\"icon\":\"https://act-upload.mihoyo.com/ys-obc/2023/05/16/183046623/d8cafe84945f729847a4ce4f5052742b_5774003124647315935.png\",\"life\":4,\"life_bg\":5,\"energy\":3,\"energy_bg\":8,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p style=\\\"white-space: pre-wrap;\\\">造成4点<strong><span style=\\\"color:rgba(146,84,222,1)\\\"><u>雷元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;雷元素伤害：&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;附着雷元素，可发生元素反应：&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;超载&lt;/strong&gt;：本伤害+2，目标强制切换到下一个角色&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;超导&lt;/strong&gt;：本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;感电&lt;/strong&gt;：本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;原激化&lt;/strong&gt;：本伤害+1，生成使下2次草/雷伤害+1的[&lt;strong&gt;激化领域&lt;/strong&gt;]&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>，召唤<strong><em>缠雷之环</em></strong>。</p>\"]}},{\"tab_name\":\"雷元素护罩\",\"skill_type\":\"被动技能\",\"icon\":\"https://act-upload.mihoyo.com/ys-obc/2023/05/16/183046623/29bed6cc6a0b0a1a5a96dc19d0631a03_4261642126110940260.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p style=\\\"white-space: pre-wrap;\\\">【被动】战斗开始时，初始附属<strong><u>雷元素护罩</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;雷元素护罩：&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;状态&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;所附属角色&lt;strong&gt;免疫所有伤害&lt;/strong&gt;。&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;此状态提供2次&lt;strong&gt;&lt;span style=&#34;color:rgba(146,84,222,1)&#34;&gt;雷元素附着&lt;/span&gt;&lt;/strong&gt;（可被元素反应消耗）：耗尽后移除此状态，并使所附属角色直到本回合结束前&lt;strong&gt;无法使用技能&lt;/strong&gt;。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]}}]}\n",
