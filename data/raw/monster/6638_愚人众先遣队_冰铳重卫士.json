      "components": [
        {
          "component_id": "card_skill",
          "layout": "",
          "data": "{\"list\":[{\"tab_name\":\"近身冲撞\",\"skill_type\":\"普通攻击\",\"icon\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/12/183046623/03e9e5156cb9ba4e033d60fd5541a6b5_4461351370344497998.jpg\",\"life\":1,\"life_bg\":1,\"energy\":2,\"energy_bg\":10,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p style=\\\"white-space: pre-wrap;\\\">造成2点<strong><u>物理伤害</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;物理伤害：&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;物理伤害不会附着元素，也不会发生元素反应。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]}},{\"tab_name\":\"封冻喷剂\",\"skill_type\":\"元素战技\",\"icon\":\"https://act-upload.mihoyo.com/ys-obc/2023/05/16/183046623/bf8085539a4b5fb6967c949fe6ff3d94_5637921125952739349.png\",\"life\":3,\"life_bg\":1,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p style=\\\"white-space: pre-wrap;\\\">造成3点<strong><span style=\\\"color:rgba(145,213,255,1)\\\"><u>冰元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;冰元素伤害：&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;附着冰元素，可发生元素反应:&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;融化&lt;/strong&gt;：本伤害+2&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;超导：&lt;/strong&gt;本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;冻结&lt;/strong&gt;：本伤害+1，使目标本回合无法行动（受到物理或火元素伤害后提前解除，但是伤害+2）&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap; min-height: 1.5em;&#34;&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]}},{\"tab_name\":\"严霜铁铳\",\"skill_type\":\"元素爆发\",\"icon\":\"https://act-upload.mihoyo.com/ys-obc/2023/05/16/183046623/2601eca50e3bb6c60b963cd7e368ad7b_3375690958971029461.png\",\"life\":3,\"life_bg\":1,\"energy\":3,\"energy_bg\":8,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p style=\\\"white-space: pre-wrap;\\\">造成3点<strong><span style=\\\"color:rgba(145,213,255,1)\\\"><u>冰元素伤害</u></span></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;冰元素伤害：&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;附着冰元素，可发生元素反应:&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;融化&lt;/strong&gt;：本伤害+2&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;超导：&lt;/strong&gt;本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;&lt;strong&gt;冻结&lt;/strong&gt;：本伤害+1，使目标本回合无法行动（受到物理或火元素伤害后提前解除，但是伤害+2）&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap; min-height: 1.5em;&#34;&gt;&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>，本角色附属<strong><u>元素武装·冰</u></strong><span data-type=\\\"详情\\\" data-name=\\\"&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;元素武装·冰：&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;状态&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;所附属角色&lt;strong&gt;所受伤害-1，造成的伤害+1&lt;/strong&gt;。&lt;/p&gt;&lt;p style=&#34;white-space: pre-wrap;&#34;&gt;此状态会提供2次&lt;strong&gt;&lt;span style=&#34;color:rgba(145,213,255,1)&#34;&gt;冰元素附着&lt;/span&gt;&lt;/strong&gt;（可被元素反应消耗），耗尽后移除此状态，并使所附属角色直到本回合结束前&lt;strong&gt;无法使用技能&lt;/strong&gt;。&lt;/p&gt;\\\" class=\\\"wiki-note-text\\\"><sup class=\\\"wiki-sup\\\">[详情]</sup></span>。</p>\"]}},{\"tab_name\":\"战备补给\",\"skill_type\":\"被动技能\",\"icon\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/12/183046623/4ac27357cbe84c9d59bbf48fed2369e4_6449718458998741692.jpg\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"<p style=\\\"white-space: pre-wrap;\\\">【被动】战斗开始时，本角色获得2点充能。</p>\"]}}]}\n",
