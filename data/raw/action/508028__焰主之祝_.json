          "data": "{\"moduleName\":\"基础信息\",\"layout_\":\"left\",\"name\":\"「焰主之祝」\",\"common_img\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/02/25/288180982/22fa99041f45edbc6ca1e993dff5b20d_2174297160903554864.png\",\"gold_img\":\"\",\"life\":3,\"life_bg\":4,\"energy\":2,\"energy_bg\":8,\"attr\":[{\"key\":\"类型：\",\"value\":[\"装备牌\"]},{\"key\":\"标签：\",\"value\":[\"天赋\"]},{\"key\":\"获取：\",\"value\":[\"猫尾酒馆对战获取\"]},{\"key\":\"花费：\",\"value\":[\"3\"]}],\"baseInfoSwitchDisabled\":false}",
