          "data": "{\"moduleName\":\"基础信息\",\"layout_\":\"left\",\"name\":\"缠忆君影梦相见\",\"common_img\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/08/258999284/58631fd1402624eea99a18ae87102c34_6983160622552680267.png\",\"gold_img\":\"\",\"life\":3,\"life_bg\":3,\"energy\":0,\"energy_bg\":0,\"attr\":[{\"key\":\"类型：\",\"value\":[\"装备牌\"]},{\"key\":\"标签：\",\"value\":[\"天赋\"]},{\"key\":\"获取：\",\"value\":[\"猫尾酒馆对战获取\"]},{\"key\":\"花费：\",\"value\":[\"3\"]}],\"baseInfoSwitchDisabled\":false}",
