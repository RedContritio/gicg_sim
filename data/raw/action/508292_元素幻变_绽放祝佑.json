          "data": "{\"moduleName\":\"基础信息\",\"layout_\":\"left\",\"name\":\"元素幻变：绽放祝佑\",\"common_img\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/08/80663279/5ced1b4b1e89eecdf056d75e4da83f67_3327557449895811907.png\",\"gold_img\":\"\",\"life\":2,\"life_bg\":9,\"energy\":0,\"energy_bg\":0,\"attr\":[{\"key\":\"类型：\",\"value\":[\"支援牌\"]},{\"key\":\"标签：\",\"value\":[\"元素幻变\"]},{\"key\":\"获取：\",\"value\":[\"卡牌商店购买获取\"]},{\"key\":\"花费：\",\"value\":[\"2\"]}],\"baseInfoSwitchDisabled\":false}",
