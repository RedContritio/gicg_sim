          "data": "{\"moduleName\":\"基础信息\",\"layout_\":\"left\",\"name\":\"愿一切欢睦陪伴你\",\"common_img\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/08/80663279/9a0eb459e86399a81ad6d57be21a1c67_7762291992829725301.png\",\"gold_img\":\"\",\"life\":3,\"life_bg\":6,\"energy\":2,\"energy_bg\":8,\"attr\":[{\"key\":\"类型：\",\"value\":[\"装备牌\"]},{\"key\":\"标签：\",\"value\":[\"天赋\"]},{\"key\":\"获取：\",\"value\":[\"猫尾酒馆对战获取\"]},{\"key\":\"花费：\",\"value\":[\"3\"]}],\"baseInfoSwitchDisabled\":false}",
