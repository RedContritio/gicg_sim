          "data": "{\"moduleName\":\"基础信息\",\"layout_\":\"left\",\"name\":\"汇流\",\"common_img\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/21/258999284/3280d5cf9ecdd8f5df379683bdf4c417_4859183962332045900.png\",\"gold_img\":\"\",\"life\":2,\"life_bg\":6,\"energy\":0,\"energy_bg\":0,\"attr\":[{\"key\":\"类型：\",\"value\":[\"装备牌\"]},{\"key\":\"标签：\",\"value\":[\"天赋\"]},{\"key\":\"获取：\",\"value\":[\"酒馆挑战·友好对局\"]},{\"key\":\"花费：\",\"value\":[\"2\"]}],\"baseInfoSwitchDisabled\":false}",
