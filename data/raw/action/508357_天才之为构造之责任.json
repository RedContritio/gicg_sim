          "data": "{\"moduleName\":\"基础信息\",\"layout_\":\"left\",\"name\":\"天才之为构造之责任\",\"common_img\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/80663279/be2e26f9fedcd9f7641d94b885688034_4719055711681842693.png\",\"gold_img\":\"\",\"life\":3,\"life_bg\":6,\"energy\":2,\"energy_bg\":8,\"attr\":[{\"key\":\"类型：\",\"value\":[\"装备牌\"]},{\"key\":\"标签：\",\"value\":[\"天赋\"]},{\"key\":\"获取：\",\"value\":[\"猫尾酒馆挑战获取\"]},{\"key\":\"花费：\",\"value\":[\"3\"]}],\"baseInfoSwitchDisabled\":false}",
